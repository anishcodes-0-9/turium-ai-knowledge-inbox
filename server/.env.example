# ---- Server ----
PORT=3001
LOG_LEVEL=info                 # fatal|error|warn|info|debug|trace|silent
DATABASE_PATH=./data/inbox.db  # SQLite file; ":memory:" for ephemeral

# ---- AI provider (any OpenAI-compatible API) ----
# OpenAI:  AI_BASE_URL=https://api.openai.com/v1   AI_API_KEY=sk-...
# Ollama:  AI_BASE_URL=http://127.0.0.1:11434/v1   AI_API_KEY=ollama
#          EMBEDDING_MODEL=nomic-embed-text  CHAT_MODEL=qwen2.5:1.5b   (or llama3.2 / llama3 if you have the RAM)
#          AI_TIMEOUT_MS=120000  AI_MAX_RETRIES=0  RETRIEVAL_MIN_SCORE=0.5   (local models are slower; nomic scores run higher).2
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=          # optional; if set, embeddings with a different length are rejected
CHAT_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# ---- Chunking (characters; ~4 chars per token) ----
CHUNK_SIZE_CHARS=2800          # ~700 tokens
CHUNK_OVERLAP_CHARS=400        # ~100 tokens

# ---- Retrieval ----
RETRIEVAL_TOP_K=6              # default number of chunks sent to the LLM
RETRIEVAL_MIN_SCORE=0.30       # cosine similarity threshold (model dependent, see README)
RETRIEVAL_CONTEXT_BUDGET_CHARS=12000  # ~3000 tokens of evidence

# ---- Ingestion ----
INGEST_MAX_ATTEMPTS=3
INGEST_POLL_INTERVAL_MS=1000
NOTE_MAX_CHARS=50000
URL_FETCH_TIMEOUT_MS=10000
URL_MAX_BYTES=2000000          # 2 MB
URL_MAX_REDIRECTS=3
